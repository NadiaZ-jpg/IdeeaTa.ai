# Copiază în .env / .env.local și completează valorile.

# AI
GEMINI_API_KEY=

# App
APP_URL=https://ideeata.ai

# Firebase client (public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-only — OBLIGATORIU pentru /api/share, promo, webhook)
# Din Firebase Console → Project settings → Service accounts → Generate new private key
# FIREBASE_PRIVATE_KEY pe o singură linie cu \n escapat, ex:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Promo codes (server-only; preferate față de NEXT_PUBLIC_*)
# Folosite doar în development când lipsește Firebase Admin.
# Standard (test): STANDARD_NADIA — doar pachet Standard, NU Full Access.
# Full Access: ADMIN_NADIA (sau PROMO_ADMIN).
PROMO_ADMIN=
PROMO_STANDARD=STANDARD_NADIA
PROMO_FONDURI=

# Lemon Squeezy (server-only)
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Checkout shareable UUIDs (buy links)
LEMON_RON_STANDARD=
LEMON_RON_EU_FUNDS=
LEMON_RON_PRO=
LEMON_RON_PRO_TOPUP=
LEMON_EUR_STANDARD=
LEMON_EUR_EU_FUNDS=
LEMON_EUR_PRO=
LEMON_EUR_PRO_TOPUP=
# Numeric variant IDs from Lemon Dashboard (webhook unlock — REQUIRED in production)
LEMON_RON_STANDARD_VARIANT_ID=
LEMON_RON_EU_FUNDS_VARIANT_ID=
LEMON_RON_PRO_VARIANT_ID=
LEMON_RON_PRO_TOPUP_VARIANT_ID=
LEMON_EUR_STANDARD_VARIANT_ID=
LEMON_EUR_EU_FUNDS_VARIANT_ID=
LEMON_EUR_PRO_VARIANT_ID=
LEMON_EUR_PRO_TOPUP_VARIANT_ID=
# Optional product IDs (also mapped for webhook)
# LEMON_RON_STANDARD_PRODUCT_ID=
# LEMON_RON_PRO_TOPUP_PRODUCT_ID=
# LEMON_EUR_PRO_TOPUP_PRODUCT_ID=

# Rate limit: uses Firestore `rate_limits` when Firebase Admin is configured
# (shared across Node instances). Falls back to in-memory Map otherwise.
# Nginx should set X-Real-IP (or append to X-Forwarded-For) — app trusts
# X-Real-IP first, then the rightmost XFF hop (not the client-spoofable leftmost).
